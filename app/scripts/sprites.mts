// Imports position sprites made in ChatGPT (see ../../sprites/PROMPTS.md).
//
// Put images named <positionId>.png (or .jpg/.webp) in ../../sprites/originals/, then run:
//   npm run sprites
// It makes 256px PNG copies for the web dex (../../sprites/<id>.png) and the app
// (assets/sprites/<id>.png), writes src/data/sprites.ts, and updates the SPRITES list
// in ../../grappling-dex.html. Re-run whenever you add, replace or remove an image.
import { execFileSync } from 'node:child_process';
import { copyFileSync, existsSync, mkdirSync, readdirSync, readFileSync, rmSync, writeFileSync } from 'node:fs';
import { extname, basename } from 'node:path';

const root = new URL('../../', import.meta.url).pathname;
const originals = `${root}sprites/originals`;
const webOut = `${root}sprites`;
const appOut = `${root}app/assets/sprites`;
const SIZE = 256;

const catalog = JSON.parse(readFileSync(`${root}app/src/data/catalog.json`, 'utf8')) as { positions: { id: string }[] };
const positionIds = new Set(catalog.positions.map(p => p.id));

mkdirSync(originals, { recursive: true });
mkdirSync(appOut, { recursive: true });

const found = new Map<string, string>();
for (const f of readdirSync(originals)) {
  const ext = extname(f).toLowerCase();
  if (!['.png', '.jpg', '.jpeg', '.webp'].includes(ext)) continue;
  const id = basename(f, extname(f));
  if (!positionIds.has(id)) { console.warn(`Skipped ${f}: no position with id "${id}" (see PROMPTS.md for file names)`); continue; }
  found.set(id, `${originals}/${f}`);
}

const hasSips = (() => { try { execFileSync('which', ['sips'], { stdio: 'ignore' }); return true; } catch { return false; } })();
const ids = [...found.keys()].sort();

// Remove generated copies whose original is gone.
for (const dir of [webOut, appOut]) {
  for (const f of readdirSync(dir)) {
    if (f.endsWith('.png') && positionIds.has(basename(f, '.png')) && !found.has(basename(f, '.png'))) rmSync(`${dir}/${f}`);
  }
}

for (const id of ids) {
  const src = found.get(id)!;
  const web = `${webOut}/${id}.png`;
  if (hasSips) execFileSync('sips', ['-s', 'format', 'png', '-Z', String(SIZE), src, '--out', web], { stdio: 'ignore' });
  else copyFileSync(src, web); // no resizer available: use the original as-is
  copyFileSync(web, `${appOut}/${id}.png`);
}

// App: a static map, because React Native bundles images through require().
const ts = [
  '// Generated by `npm run sprites` from sprites/originals. Do not edit.',
  'export const SPRITES: Record<string, number> = {',
  ...ids.map(id => `  ${JSON.stringify(id)}: require('../../assets/sprites/${id}.png'),`),
  '};',
  '',
].join('\n');
writeFileSync(`${root}app/src/data/sprites.ts`, ts);

// Web dex: the list of positions that have a sprite.
const htmlPath = `${root}grappling-dex.html`;
const html = readFileSync(htmlPath, 'utf8');
const marker = /const SPRITES = new Set\(\[[^\]]*\]\);/;
if (!marker.test(html)) throw new Error('SPRITES line not found in grappling-dex.html');
writeFileSync(htmlPath, html.replace(marker, `const SPRITES = new Set(${JSON.stringify(ids)});`));

console.log(ids.length ? `Sprites: ${ids.length} of ${positionIds.size} positions (${ids.join(', ')})` : 'No sprites yet. Add images to sprites/originals/.');
if (!hasSips && ids.length) console.warn('sips not found, so images were copied without resizing.');
if (!existsSync(`${root}sprites/PROMPTS.md`)) console.warn('sprites/PROMPTS.md is missing.');
